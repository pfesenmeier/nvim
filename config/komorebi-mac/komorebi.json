{
  "$schema": "https://komorebi-for-mac.lgug2z.com/komorebi.0.1.0.schema.json",
  "app_specific_configuration_path": "$HOME/.config/komorebi/applications.json",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 15,
  "default_container_padding": 15,
  "border": true,
  "border_width": 7,
  "border_offset": -1,
  "border_radius": 10,
  "floating_window_aspect_ratio": "Widescreen",
  "floating_layer_behaviour": "Float",
  "resize_delta": 100,
  "animation": {
    "enabled": true,
    "style": "EaseOutExpo",
    "fps": 120
  },
  "theme": {
    "palette": "Base16",
    "name": "EverforestDarkHard",
    "unfocused_border": "Base02",
    "monocle_border": "Base09",
    "bar_accent": "Base0A"
  },
  "layout_defaults": {
    "Scrolling": {
      "layout_options": {
        "scrolling": {
          "columns": 2
        }
      }
    }
  },
  "ignore_rules": [],
  "floating_applications": [],
  "manage_rules": [
    {
      "kind": "Title",
      "id": "Claude",
      "matching_strategy": "Equals"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "Dev",
          "layout": "BSP"
        }
      ]
    }
  ]
}
