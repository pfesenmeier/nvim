# Reload skhd / komorebi configuration
alt - o                 : skhd --reload
alt + shift - o         : komorebic replace-configuration $HOME/.config/komorebi/komorebi.json

# App shortcuts - focus if open, launch if not
alt + shift - return    : open -a Firefox

# Window ops
alt - q                 : komorebic close
alt - m                 : komorebic minimize

# used by neovim quickfix
# alt - h               : komorebic focus left
# alt - l               : komorebic focus right
# alt - j               : komorebic focus down
# alt - k               : komorebic focus up
alt - p                 : komorebic cycle-focus previous
alt - n                 : komorebic cycle-focus next
alt + shift - p         : komorebic cycle-move previous
alt + shift - n         : komorebic cycle-move next

# Move windows
alt + shift - h         : komorebic move left
alt + shift - j         : komorebic move down
alt + shift - k         : komorebic move up
alt + shift - l         : komorebic move right
alt - space             : komorebic promote

# Stack windows
alt + shift - 9         : komorebic stack left
alt + shift - down      : komorebic stack down
alt + shift - up        : komorebic stack up
alt + shift - right     : komorebic stack right
alt - 0x29              : komorebic unstack # 0x29 is ;
alt - 9                 : komorebic cycle-stack previous
alt - 0                 : komorebic cycle-stack next

# Resize
alt - 0x18              : komorebic resize-axis horizontal increase # 0x18 is +
alt - 0x1B              : komorebic resize-axis horizontal decrease # 0x1B is -
alt + shift - 0x18      : komorebic resize-axis vertical increase
alt + shift - 0x1B      : komorebic resize-axis vertical decrease

# Manipulate windows
alt - t                 : komorebic toggle-float
alt - f                 : komorebic toggle-monocle

# Window manager options
alt - r                 : komorebic retile
alt + shift - r         : komorebic stop; komorebic start --bar

# Layouts
alt - x                 : komorebic flip-layout horizontal
alt - y                 : komorebic flip-layout vertical
alt - s                 : komorebic change-layout scrolling
alt - b                 : komorebic change-layout bsp
