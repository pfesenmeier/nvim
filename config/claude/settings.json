{
  "env": {
    "EDITOR": "nvim",
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "SSH_AUTH_SOCK": ""
  },
  "permissions": {
    "allow": [
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(xargs:*)",
      "Bash(cat:*)",
      "Bash(jj diff:*)",
      "Bash(jj show:*)",
      "Bash(jj log:*)",
      "Bash(jj help:*)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "Bash(stat:*)",
      "Bash(mkdir:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(curl -s -X POST http://localhost:5049/graphql:*)",
      "Read(~/Documents/pop-quizzes/**)",
      "Edit(~/Documents/pop-quizzes/**)",
      "Read(~/.cache/pop-quiz/**)",
      "WebSearch",
      "Bash(git clone --depth 1:*)",
      "Bash(man:*)",
      "Bash(nvim --headless:*)",
      "Bash(nvim --version:*)",
      "Bash(jj --no-pager:*)",
      "Bash(jj --help:*)",
      "Bash(jj config list:*)",
      "Bash(jj op log:*)",
      "Bash(jj --version:*)"
    ],
    "deny": [
      "Bash(ssh:*)",
      "Bash(ssh-add:*)",
      "Bash(ssh-agent:*)",
      "Bash(ssh-keygen:*)",
      "Bash(ssh-keyscan:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(/usr/bin/ssh:*)",
      "Bash(/usr/bin/ssh-add:*)",
      "Bash(/usr/bin/ssh-keygen:*)",
      "Bash(/usr/bin/scp:*)",
      "Bash(/usr/bin/sftp:*)",
      "Bash(/usr/bin/rsync:*)",
      "Bash(gpg:*)",
      "Bash(gpg2:*)",
      "Bash(gpgsm:*)",
      "Bash(gpgconf:*)",
      "Bash(gpg-connect-agent:*)",
      "Bash(gpg-preset-passphrase:*)",
      "Bash(/home/linuxbrew/.linuxbrew/bin/gpg:*)",
      "Bash(/home/linuxbrew/.linuxbrew/bin/gpgsm:*)",
      "Bash(/home/linuxbrew/.linuxbrew/bin/gpgconf:*)",
      "Bash(/home/linuxbrew/.linuxbrew/bin/gpg-connect-agent:*)",
      "Bash(pass:*)",
      "Bash(/usr/bin/pass:*)",
      "Bash(secret-tool:*)",
      "Bash(/home/linuxbrew/.linuxbrew/bin/secret-tool:*)",
      "Bash(git credential:*)",
      "Bash(env:*)",
      "Bash(/usr/bin/env:*)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(~/.password-store/**)",
      "Edit(~/nvim/config/gpg-agent.conf)",
      "Edit(~/nvim/config/gpg-agent.conf.mac)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "prog-claude 1 25",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "prog-claude 1 100",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "prog-claude 2",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "prog-claude 4",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "elicitation_complete|elicitation_response",
        "hooks": [
          {
            "type": "command",
            "command": "prog-claude 1 25",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "prog-claude 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "viewMode": "default",
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "auto"
}
